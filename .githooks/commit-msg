#!/bin/bash
#
# Global commit-msg hook. Rejects commit messages that contain:
#   1. Literal backslash-n sequences (usually a shell-quoting bug that
#      produces a single-line message rendered with visible "\n" on
#      GitLab / GitHub).
#   2. References to paths the pre-commit hook already blocks from file
#      content. The shared pattern list lives alongside this hook.
#
# Usage: installed via `git config --global core.hooksPath ~/.githooks`.
# Git invokes this hook with $1 = path to the commit message file and
# an optional $2 = source (message, template, merge, squash, commit).
# Exit 0 = accept, non-zero = reject the commit.

set -u

msg_file="${1:-}"
[[ -r "$msg_file" ]] || exit 0

# Strip comment lines before scanning, matching git's own finalization.
scan_content=$(grep -v '^#' "$msg_file")

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
blocked_value_guard="${hook_dir}/check-blocked-value"
if [[ ! -x "$blocked_value_guard" ]]; then
    echo "ERROR: blocked value guard is missing or not executable: $blocked_value_guard" >&2
    exit 1
fi

current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [[ -n "$current_branch" ]] && matched_pattern="$("$blocked_value_guard" names "$current_branch")"; then
    printf 'ERROR: current branch %q matches blocked pattern %q\n' "$current_branch" "$matched_pattern" >&2
    exit 1
fi

if matched_pattern="$(printf '%s\n' "$scan_content" | "$blocked_value_guard" names)"; then
    printf 'ERROR: commit message matches blocked pattern %q\n' "$matched_pattern" >&2
    exit 1
fi

# Skip remaining prose checks for auto-generated sources.
case "${2:-}" in
    merge|squash|commit) exit 0 ;;
esac

# --- Check 1: literal backslash-n ---
if [[ "$scan_content" =~ \\n ]]; then
    {
        echo "ERROR: commit message contains a literal backslash-n sequence."
        echo "This usually means the message was passed as a single-quoted"
        echo "string with escaped newlines that the shell did not expand."
        echo ""
        echo "Fix: use a heredoc or an editor so real newlines are written."
        echo ""
        echo "Offending lines:"
        grep -n '\\n' "$msg_file" | head -5
    } >&2
    exit 1
fi

is_already_tracked_in_head() {
    git cat-file -e "HEAD:$1" 2>/dev/null
}

has_tracked_prefix_in_head() {
    git ls-tree -r --name-only HEAD -- "$1" 2>/dev/null | grep . >/dev/null
}

has_tracked_instruction_name() {
    local name="$1"
    git ls-tree -r --name-only HEAD 2>/dev/null |
        grep -E "(^|/)${name//./\\.}$" >/dev/null
}

pattern_allowed_by_repo_context() {
    local pattern="$1"
    case "$pattern" in
        '(^|[^[:alnum:]_])AGENTS\.md([^[:alnum:]_]|$)')
            has_tracked_instruction_name "AGENTS.md"
            ;;
        '(^|[^[:alnum:]_])SUBAGENTS\.md([^[:alnum:]_]|$)')
            has_tracked_instruction_name "SUBAGENTS.md" ||
                is_already_tracked_in_head "AGENTS.md"
            ;;
        'ai_wiki/')
            has_tracked_prefix_in_head "ai_wiki"
            ;;
        'ai_scripts/')
            has_tracked_prefix_in_head "ai_scripts"
            ;;
        '\.agents/skills/')
            has_tracked_prefix_in_head ".agents/skills"
            ;;
        *)
            return 1
            ;;
    esac
}

# --- Check 2: blocked path references (shared list) ---
patterns_file="$(dirname "${BASH_SOURCE[0]}")/blocked-patterns"
if [[ -r "$patterns_file" ]]; then
    # Read non-comment, non-empty patterns.
    mapfile -t blocked_patterns < <(grep -vE '^\s*(#|$)' "$patterns_file")
    for pattern in "${blocked_patterns[@]}"; do
        if pattern_allowed_by_repo_context "$pattern"; then
            continue
        fi
        if grep -qE "$pattern" <<<"$scan_content"; then
            {
                echo "ERROR: commit message references a blocked path."
                echo "Matched pattern from $patterns_file: $pattern"
                echo ""
                echo "Commit messages must not introduce references to"
                echo "internal-only paths in repos that do not already track"
                echo "those paths. Remove the reference and try again."
            } >&2
            exit 1
        fi
    done
fi

exit 0
