#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") <names|all> [value]" >&2
  echo "       omit value to read it from standard input" >&2
}

[[ $# -ge 1 && $# -le 2 ]] || { usage; exit 2; }
scope="$1"
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
input_file="$(mktemp "${TMPDIR:-/tmp}/check-blocked-value.XXXXXX")"
trap 'rm -f -- "${input_file}"' EXIT
if [[ $# -eq 2 ]]; then
  printf '%s\n' "$2" >"${input_file}"
else
  cat >"${input_file}"
fi

match_file() {
  local file="$1" pattern status
  [[ -r "$file" ]] || return 1

  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    pattern="${pattern%$'\r'}"
    [[ "$pattern" =~ ^[[:space:]]*(#|$) ]] && continue

    set +e
    grep -Eiq -- "$pattern" "${input_file}"
    status=$?
    set -e
    case "$status" in
      0) printf '%s\n' "$pattern"; return 0 ;;
      1) ;;
      *) printf 'invalid ERE: %s\n' "$pattern"; return 0 ;;
    esac
  done < "$file"
  return 1
}

case "$scope" in
  names)
    match_file "$hook_dir/blocked-names"
    ;;
  all)
    match_file "$hook_dir/blocked-names" || match_file "$hook_dir/blocked-patterns"
    ;;
  *)
    usage
    exit 2
    ;;
esac
