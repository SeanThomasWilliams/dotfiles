#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Provisioning shells must see newly installed helpers before the next login.
export PATH="$HOME/scripts:$HOME/bin:$HOME/.local/bin:$PATH"
export GOBIN="$HOME/.local/bin"

# Darwin/Linux
UNAME_S="$(uname -s)"
HOSTNAME_S="$(hostname -s)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$XDG_CONFIG_HOME"

if [[ -f "$SCRIPT_DIR/.gitmodules" ]]; then
  git submodule update --init --recursive
else
  echo >&2 "No declared submodules"
fi

for fname in "$SCRIPT_DIR"/.*; do
  [[ ! -f $fname ]] && continue # Skip non-files

  fname_src="$fname"
  fname_base=$(basename "$fname")
  fname_target="$HOME/$fname_base"

  if [[ "$fname_base" =~ ^\.(tags.*|DS_Stor|)$ ]]; then
    echo >&2 "Skipping $fname"
    continue
  fi

  if ! [[ "$fname_base" = *.json || "$fname_base" = *.conf || "$fname_base" = *.local || "$fname_base" = *.lua ]]; then
    if [[ "$fname_base" =~ \..*\..* ]]; then
      echo >&2 "Skipping dotfile variant $fname"
      continue
    fi
  fi

  # Handle os-specific config files
  if [[ -f "$fname.$UNAME_S" ]]; then
    fname_src="$fname.$UNAME_S"
    echo >&2 "Using $fname_src for $fname"
  fi

  # Handle host-specific config files
  if [[ -f "$fname.$HOSTNAME_S" ]]; then
    fname_src="$fname.$HOSTNAME_S"
    echo >&2 "Using $fname_src for $fname"
  fi

  ln -vsfn "$fname_src" "$fname_target"
done

# Bash-completion
mkdir -p "$HOME/.local/share/"
rm -f "$HOME/.local/share/bash-completion"
ln -sfn "$SCRIPT_DIR/.local/share/bash-completion" "$HOME/.local/share/"

# For neovim
ln -sfn "$SCRIPT_DIR"/vim "$XDG_CONFIG_HOME/nvim"
ln -sfn "$SCRIPT_DIR"/.vimrc "$XDG_CONFIG_HOME/nvim/init.vim"

# Config dir
for dname in "$SCRIPT_DIR"/config/*; do
  [[ -e "$dname" ]] || continue
  dname_src="$dname"
  dname_base=$(basename "$dname")
  dname_target="$XDG_CONFIG_HOME/$dname_base"

  if [[ "$dname_base" =~ .*\..* ]]; then
    echo >&2 "Skipping config dir variant $dname"
    continue
  fi

  # Handle os-specific config files
  if [[ -d "$dname.$UNAME_S" ]]; then
    dname_src="$dname.$UNAME_S"
    echo >&2 "Using $dname_src for $dname"
  fi

  # Handle host-specific config files
  if [[ -d "$dname.$HOSTNAME_S" ]]; then
    dname_src="$dname.$HOSTNAME_S"
  fi

  ln -vsfn "$dname_src" "$XDG_CONFIG_HOME/$dname_base"
done

config_dirs=(
  .ctags.d
  .ipython
  .githooks
)

for config_dir in "${config_dirs[@]}"; do
  ln -vsfn "$SCRIPT_DIR/$config_dir" "$HOME/$config_dir"
done

# Binaries
mkdir -p "$HOME"/bin
for binfile in "$SCRIPT_DIR"/bin/*; do
  [[ -e "$binfile" || -L "$binfile" ]] || continue
  ln -vsfn "$binfile" "$HOME/bin/"
done

make -C "$SCRIPT_DIR" wrappers
WRAPPED_CLI_DIR="$HOME/.local/libexec/dotfiles"
mkdir -p "$WRAPPED_CLI_DIR"
for wrapped_cli in gh glab; do
  install -m 0111 "$SCRIPT_DIR/build/$wrapped_cli" "$WRAPPED_CLI_DIR/$wrapped_cli"
  ln -vsfn "$WRAPPED_CLI_DIR/$wrapped_cli" "$HOME/bin/$wrapped_cli"
done

for binfile in "${SCRIPT_DIR}/${UNAME_S}"/bin/*; do
  [[ ! -f "$binfile" ]] && continue
  ln -vsfn "$binfile" "$HOME"/bin/"$(basename "$binfile")"
done

mkdir -p "$HOME"/scripts
for scriptsfile in "$SCRIPT_DIR"/scripts/*; do
  [[ -e "$scriptsfile" || -L "$scriptsfile" ]] || continue
  ln -vsfn "$scriptsfile" "$HOME/scripts/"
done
for scriptsfile in "${SCRIPT_DIR}/${UNAME_S}"/scripts/*; do
  [[ ! -f "$scriptsfile" ]] && continue
  ln -vsfn "$scriptsfile" "$HOME"/scripts/"$(basename "$scriptsfile")"
done

# Vim dir
rm -f "$HOME"/.vim
ln -sfn "$SCRIPT_DIR"/vim "$HOME"/.vim

"$SCRIPT_DIR/install-helpers"

# Keep editor setup here so command-line helpers can be upgraded independently.
# Declare all plugins before loading Lua/theme configuration that needs them.
nvim --headless --cmd 'let g:dotfiles_installing_plugins = 1' '+PlugInstall --sync' +messages +qall
# Wait for configured parsers before this short-lived editor exits.
DOTFILES_INSTALL_PARSERS=1 nvim --headless +GoInstallBinaries +messages +qall
# Providers and plugins are installed before remote-plugin registration.
nvim --headless +UpdateRemotePlugins +messages +qall
